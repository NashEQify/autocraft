{
  "name": "autocraft",
  "license": "MIT OR Apache-2.0",
  "version": "0.1.0",
  "description": "Backlog mirror, triage pipeline state and dashboard for the storytold craft apps",
  "private": true,
  "packageManager": "pnpm@11.28.10",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "autocraft-server": "src/cli.ts",
    "craft-auto": "src/cli.ts"
  },
  "scripts": {
    "check": "tsc --noEmit && npm run docs:check && npm run pg-schema:check",
    "docs": "node scripts/gen-docs.ts",
    "docs:check": "node scripts/gen-docs.ts --check",
    "docs:image": "node scripts/flowchart-shot.mjs",
    "gql-schema": "scripts/gql-schema.sh",
    "pg-schema": "node scripts/gen-pg-schema.ts",
    "pg-schema:check": "node scripts/gen-pg-schema.ts --check",
    "test": "node --test",
    "test:pg": "scripts/pg-test.sh run"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "graphql": "^17.0.2",
    "ts5": "npm:typescript@~5.9.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@xterm/headless": "^6.0.0",
    "kysely": "^0.29.9",
    "pg": "^8.23.1"
  }
}
